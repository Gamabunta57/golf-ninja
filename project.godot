; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Golf Ninja"
run/main_scene="uid://p4dtrhu4i74n"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*res://Singletons/global.gd"
SignalBus="*res://Singletons/signal_bus.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/size/initial_position_type=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Scenes/Balls/": "orange",
"res://Scenes/Drone/": "red",
"res://Scenes/Grapple/": "purple",
"res://Scenes/Kunai/": "teal",
